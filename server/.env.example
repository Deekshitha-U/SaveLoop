# Server: never commit this file after copying to .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
# Use this for local development; place serviceAccountKey.json privately in server/.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional server-side credentials for production
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_VECTOR_INDEX=bookmark_vector_index

# Optional automatic URL analysis integrations. Secrets stay on the SERVER.
# YouTube Data API returns description and tags; public oEmbed title works without a key.
YOUTUBE_API_KEY=
# Pinterest API only returns permitted Pins with pins:read access.
PINTEREST_ACCESS_TOKEN=
# Meta public oEmbed; token is optional for supported public posts.
META_GRAPH_VERSION=v27.0
META_OEMBED_ACCESS_TOKEN=
# Website article metadata. Microlink receives URLs during user-requested analysis.
METADATA_PROVIDER=microlink
MICROLINK_API_KEY=
